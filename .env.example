# Copy to .env. `npm run db:setup` creates .env for you locally if it is missing.
# Change the admin password before any public deploy. Never commit .env.

# --- Required to sign in ---
ADMIN_EMAIL=harry@localhost
ADMIN_PASSWORD=growth-engine-local
# Generated by db:setup when empty. Required in production.
AUTH_SECRET=

# Local SQLite file. Ignored when DATABASE_URL is a postgres URL.
SQLITE_PATH=data/growth.sqlite

# Production / Vercel: postgres connection string. SQLite is the local fallback.
# DATABASE_URL=postgres://user:pass@host:5432/growth

# Public origin used in referral links, unsubscribe links, and the snippet.
# APP_ORIGIN=http://127.0.0.1:3847

# Optional write key for /api/track. When set, events must send it.
# It is a public write key (it ships in the snippet), not a secret.
# TRACK_PUBLIC_KEY=
# TRACK_CORS_ORIGIN=*

# --- LLM: the first one that is configured wins, unless LLM_PROVIDER is set ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# --- Ads. Pause and budget changes run only after an approval click. ---
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=
# META_GRAPH_VERSION=v21.0
# META_AD_LIBRARY_TOKEN=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_ACCESS_TOKEN=
# GOOGLE_ADS_API_VERSION=v18
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_ADVERTISER_ID=

# --- Analytics imports ---
# GA4_PROPERTY_ID=
# GA4_ACCESS_TOKEN=
# MIXPANEL_API_SECRET=
# YOUTUBE_API_KEY=

# --- Messaging. Nothing sends until a flow or ticket is approved, unless that flow's auto-send is on. ---
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# SENDGRID_API_KEY=
# EMAIL_FROM=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Affiliates. Transfers run only after an approval click. ---
# STRIPE_SECRET_KEY=

# Vercel cron auth. The cron route also accepts x-vercel-cron when this is unset.
# CRON_SECRET=
